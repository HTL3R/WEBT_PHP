# Read by Docker Compose / podman-compose (not by PHP) when the container is
# created. Apache runs as this uid/gid so files PHP writes stay editable on the
# host; 1000:1000 suits Linux and WSL. A value exported in the shell wins.
#
# These must be set here and not only as defaults in docker-compose.yml:
# podman-compose 1.3 passes `PUID: "${PUID:-1000}"` through literally unless
# PUID is defined in the shell or in this file, and the container then
# crash-loops on `groupmod: invalid group ID '${PGID:-1000}'`.
PUID=1000
PGID=1000
